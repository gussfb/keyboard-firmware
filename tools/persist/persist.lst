                                      1 ; ============================================================================
                                      2 ; Persistência de iluminação pro Draxen DN202 (Sino Wealth SH68F90, fw 9.24)
                                      3 ; Guarda modo/cor/brilho/velocidade no setor de flash 0xD000 (nunca usado pelo
                                      4 ; firmware) e restaura no boot. Montado com sdas8051, colocado em 0x8300 (área
                                      5 ; livre 0x8292-0xAFFF do firmware).
                                      6 ;
                                      7 ; Hooks (aplicados por tools/patch_persist.py):
                                      8 ;   0x585C  main:  "clr a; mov r0,#0x5a; mov @r0,a"  -> "lcall boot_load; nop"
                                      9 ;   0x741F  "lcall 0x38b6" (handler de teclas/Fn)     -> "lcall hook_keys"
                                     10 ;   0x6D05  "lcall 0x4e01" (handler USB)              -> "lcall hook_usb"
                                     11 ; ============================================================================
                                     12 
                                     13         .area   CSEG (ABS)
      008300                         14         .org    0x8300
                                     15 
                                     16 ; --- variáveis do firmware (IRAM) ---
                           000076    17 MODE    = 0x76          ; 0..10 efeitos, 0x10..0x13 modos game
                           00005A    18 COLOR   = 0x5a          ; 0..6
                           00007A    19 BRIGHT  = 0x7a          ; 0..4
                           000077    20 SPEED   = 0x77          ; 0..4
                                     21 
                                     22 ; --- rotinas do firmware ---
                           0038B6    23 FW_KEYS   = 0x38b6
                           004E01    24 FW_USB    = 0x4e01
                           007F93    25 FW_ERASE  = 0x7f93      ; r7 = página (high byte)
                           007ECA    26 FW_PROG   = 0x7eca      ; r7 = página, r5 = offset, r3 = dado
                           0079D2    27 FW_LEDOFF = 0x79d2      ; desliga driver de LED (brilho 0)
                                     28 
                                     29 ; --- nosso registro em flash ---
                           0000D0    30 SECT    = 0xd0          ; página -> 0xD000
                           00D000    31 REC     = 0xd000        ; [A5][mode][color][bright][speed][chk]  chk = soma + 0x5A
                           0000A5    32 MAGIC   = 0xa5
                                     33 
                                     34 ; --- sombra em XDATA (zerada no boot pelo firmware) ---
                           0008F0    35 SH_MODE = 0x08f0
                           0008F4    36 SH_FLAG = 0x08f4        ; 1 depois do boot_load
                                     37 
                                     38 ; ----------------------------------------------------------------------------
      008300                         39 hook_keys:                          ; 0x8300
      008300 12 38 B6         [24]   40         lcall   FW_KEYS
      008303 02r83rC4         [24]   41         ljmp    check_save
      008306                         42 hook_usb:                           ; 0x8306
      008306 12 4E 01         [24]   43         lcall   FW_USB
      008309 02r83rC4         [24]   44         ljmp    check_save
                                     45 
                                     46 ; ----------------------------------------------------------------------------
                                     47 ; boot_load: chamado do main no lugar de "clr a; mov r0,#0x5a; mov @r0,a"
                                     48 ; ----------------------------------------------------------------------------
      00830C                         49 boot_load:                          ; 0x830C
      00830C E4               [12]   50         clr     a
      00830D F5 5A            [12]   51         mov     COLOR,a             ; semântica original
      00830F 90 D0 00         [24]   52         mov     dptr,#REC
      008312 E4               [12]   53         clr     a
      008313 93               [24]   54         movc    a,@a+dptr
      008314 B4 A5 02         [24]   55         cjne    a,#MAGIC,far1
      008317 80 03            [24]   56         sjmp    cont1
      008319 02r83rAB         [24]   57 far1:   ljmp    nrec
      00831C 90 D0 01         [24]   58 cont1:  mov     dptr,#REC+1
      00831F E4               [12]   59         clr     a
      008320 93               [24]   60         movc    a,@a+dptr
      008321 FA               [12]   61         mov     r2,a                ; mode
      008322 90 D0 02         [24]   62         mov     dptr,#REC+2
      008325 E4               [12]   63         clr     a
      008326 93               [24]   64         movc    a,@a+dptr
      008327 FB               [12]   65         mov     r3,a                ; color
      008328 90 D0 03         [24]   66         mov     dptr,#REC+3
      00832B E4               [12]   67         clr     a
      00832C 93               [24]   68         movc    a,@a+dptr
      00832D FC               [12]   69         mov     r4,a                ; bright
      00832E 90 D0 04         [24]   70         mov     dptr,#REC+4
      008331 E4               [12]   71         clr     a
      008332 93               [24]   72         movc    a,@a+dptr
      008333 FD               [12]   73         mov     r5,a                ; speed
      008334 90 D0 05         [24]   74         mov     dptr,#REC+5
      008337 E4               [12]   75         clr     a
      008338 93               [24]   76         movc    a,@a+dptr
      008339 FE               [12]   77         mov     r6,a                ; chk
      00833A EA               [12]   78         mov     a,r2
      00833B 2B               [12]   79         add     a,r3
      00833C 2C               [12]   80         add     a,r4
      00833D 2D               [12]   81         add     a,r5
      00833E 24 5A            [12]   82         add     a,#0x5a
      008340 6E               [12]   83         xrl     a,r6
      008341 70 1A            [24]   84         jnz     far2
                                     85         ; faixas válidas
      008343 EA               [12]   86         mov     a,r2
      008344 C3               [12]   87         clr     c
      008345 94 14            [12]   88         subb    a,#0x14
      008347 50 14            [24]   89         jnc     far2
      008349 EB               [12]   90         mov     a,r3
      00834A C3               [12]   91         clr     c
      00834B 94 07            [12]   92         subb    a,#7
      00834D 50 0E            [24]   93         jnc     far2
      00834F EC               [12]   94         mov     a,r4
      008350 C3               [12]   95         clr     c
      008351 94 05            [12]   96         subb    a,#5
      008353 50 08            [24]   97         jnc     far2
      008355 ED               [12]   98         mov     a,r5
      008356 C3               [12]   99         clr     c
      008357 94 05            [12]  100         subb    a,#5
      008359 50 02            [24]  101         jnc     far2
      00835B 80 03            [24]  102         sjmp    apply
      00835D 02r83rAB         [24]  103 far2:   ljmp    nrec
      008360                        104 apply:
                                    105         ; aplica
      008360 8A 76            [24]  106         mov     MODE,r2
      008362 8B 5A            [24]  107         mov     COLOR,r3
      008364 8C 7A            [24]  108         mov     BRIGHT,r4
      008366 8D 77            [24]  109         mov     SPEED,r5
                                    110         ; tabelas por modo (mesma init que o handler de Fn faz)
      008368 EA               [12]  111         mov     a,r2
      008369 B4 01 05         [24]  112         cjne    a,#1,t6
      00836C 12r84r65         [24]  113         lcall   init_m1
      00836F 80 0E            [24]  114         sjmp    tdone
      008371 B4 06 05         [24]  115 t6:     cjne    a,#6,t8
      008374 12r84r8A         [24]  116         lcall   init_m6
      008377 80 06            [24]  117         sjmp    tdone
      008379 B4 08 03         [24]  118 t8:     cjne    a,#8,tdone
      00837C 12r84rDF         [24]  119         lcall   init_m8
      00837F                        120 tdone:
                                    121         ; brilho (4 = default do boot, nada a fazer)
      00837F E5 7A            [12]  122         mov     a,BRIGHT
      008381 B4 04 02         [24]  123         cjne    a,#4,b3
      008384 80 25            [24]  124         sjmp    nrec
      008386 B4 03 04         [24]  125 b3:     cjne    a,#3,b2
      008389 7F 80            [12]  126         mov     r7,#0x80
      00838B 80 13            [24]  127         sjmp    bset
      00838D B4 02 04         [24]  128 b2:     cjne    a,#2,b1
      008390 7F B4            [12]  129         mov     r7,#0xb4
      008392 80 0C            [24]  130         sjmp    bset
      008394 B4 01 04         [24]  131 b1:     cjne    a,#1,b0
      008397 7F E6            [12]  132         mov     r7,#0xe6
      008399 80 05            [24]  133         sjmp    bset
      00839B 12 79 D2         [24]  134 b0:     lcall   FW_LEDOFF
      00839E 80 0B            [24]  135         sjmp    nrec
      0083A0 90 FF 95         [24]  136 bset:   mov     dptr,#0xff95
      0083A3 74 08            [12]  137         mov     a,#8
      0083A5 F0               [24]  138         movx    @dptr,a
      0083A6 90 FF B5         [24]  139         mov     dptr,#0xffb5
      0083A9 EF               [12]  140         mov     a,r7
      0083AA F0               [24]  141         movx    @dptr,a
      0083AB                        142 nrec:
                                    143         ; sombra = valores atuais; flag = 1
      0083AB 90 08 F0         [24]  144         mov     dptr,#SH_MODE
      0083AE E5 76            [12]  145         mov     a,MODE
      0083B0 F0               [24]  146         movx    @dptr,a
      0083B1 A3               [24]  147         inc     dptr
      0083B2 E5 5A            [12]  148         mov     a,COLOR
      0083B4 F0               [24]  149         movx    @dptr,a
      0083B5 A3               [24]  150         inc     dptr
      0083B6 E5 7A            [12]  151         mov     a,BRIGHT
      0083B8 F0               [24]  152         movx    @dptr,a
      0083B9 A3               [24]  153         inc     dptr
      0083BA E5 77            [12]  154         mov     a,SPEED
      0083BC F0               [24]  155         movx    @dptr,a
      0083BD 90 08 F4         [24]  156         mov     dptr,#SH_FLAG
      0083C0 74 01            [12]  157         mov     a,#1
      0083C2 F0               [24]  158         movx    @dptr,a
      0083C3 22               [24]  159         ret
