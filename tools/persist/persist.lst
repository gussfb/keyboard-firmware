                                    161 ; ----------------------------------------------------------------------------
                                    162 ; check_save: se (mode,color,bright,speed) != sombra -> atualiza sombra e grava
                                    163 ; Preserva A, PSW, DPTR, R3, R5, R7 (do banco ativo).
                                    164 ; ----------------------------------------------------------------------------
      0083C4                        165 check_save:
      0083C4 C0 E0            [24]  166         push    acc
      0083C6 C0 D0            [24]  167         push    psw
      0083C8 C0 82            [24]  168         push    dpl
      0083CA C0 83            [24]  169         push    dph
      0083CC EB               [12]  170         mov     a,r3
      0083CD C0 E0            [24]  171         push    acc
      0083CF ED               [12]  172         mov     a,r5
      0083D0 C0 E0            [24]  173         push    acc
      0083D2 EF               [12]  174         mov     a,r7
      0083D3 C0 E0            [24]  175         push    acc
      0083D5 90 08 F4         [24]  176         mov     dptr,#SH_FLAG
      0083D8 E0               [24]  177         movx    a,@dptr
      0083D9 70 03            [24]  178         jnz     cs1
      0083DB 02r84r53         [24]  179 fardone: ljmp   done
      0083DE 90 08 F0         [24]  180 cs1:    mov     dptr,#SH_MODE
      0083E1 E0               [24]  181         movx    a,@dptr
      0083E2 B5 76 11         [24]  182         cjne    a,MODE,changed
      0083E5 A3               [24]  183         inc     dptr
      0083E6 E0               [24]  184         movx    a,@dptr
      0083E7 B5 5A 0C         [24]  185         cjne    a,COLOR,changed
      0083EA A3               [24]  186         inc     dptr
      0083EB E0               [24]  187         movx    a,@dptr
      0083EC B5 7A 07         [24]  188         cjne    a,BRIGHT,changed
      0083EF A3               [24]  189         inc     dptr
      0083F0 E0               [24]  190         movx    a,@dptr
      0083F1 B5 77 02         [24]  191         cjne    a,SPEED,changed
      0083F4 80 E5            [24]  192         sjmp    fardone
      0083F6                        193 changed:
      0083F6 E5 76            [12]  194         mov     a,MODE              ; modos transitórios (>= 0x14) não salvam
      0083F8 C3               [12]  195         clr     c
      0083F9 94 14            [12]  196         subb    a,#0x14
      0083FB 50 DE            [24]  197         jnc     fardone
      0083FD 90 08 F0         [24]  198         mov     dptr,#SH_MODE
      008400 E5 76            [12]  199         mov     a,MODE
      008402 F0               [24]  200         movx    @dptr,a
      008403 A3               [24]  201         inc     dptr
      008404 E5 5A            [12]  202         mov     a,COLOR
      008406 F0               [24]  203         movx    @dptr,a
      008407 A3               [24]  204         inc     dptr
      008408 E5 7A            [12]  205         mov     a,BRIGHT
      00840A F0               [24]  206         movx    @dptr,a
      00840B A3               [24]  207         inc     dptr
      00840C E5 77            [12]  208         mov     a,SPEED
      00840E F0               [24]  209         movx    @dptr,a
                                    210         ; grava
      00840F 7F D0            [12]  211         mov     r7,#SECT
      008411 12 7F 93         [24]  212         lcall   FW_ERASE
      008414 7B A5            [12]  213         mov     r3,#MAGIC
      008416 7D 00            [12]  214         mov     r5,#0
      008418 7F D0            [12]  215         mov     r7,#SECT
      00841A 12 7E CA         [24]  216         lcall   FW_PROG
      00841D AB 76            [24]  217         mov     r3,MODE
      00841F 7D 01            [12]  218         mov     r5,#1
      008421 7F D0            [12]  219         mov     r7,#SECT
      008423 12 7E CA         [24]  220         lcall   FW_PROG
      008426 AB 5A            [24]  221         mov     r3,COLOR
      008428 7D 02            [12]  222         mov     r5,#2
      00842A 7F D0            [12]  223         mov     r7,#SECT
      00842C 12 7E CA         [24]  224         lcall   FW_PROG
      00842F AB 7A            [24]  225         mov     r3,BRIGHT
      008431 7D 03            [12]  226         mov     r5,#3
      008433 7F D0            [12]  227         mov     r7,#SECT
      008435 12 7E CA         [24]  228         lcall   FW_PROG
      008438 AB 77            [24]  229         mov     r3,SPEED
      00843A 7D 04            [12]  230         mov     r5,#4
      00843C 7F D0            [12]  231         mov     r7,#SECT
      00843E 12 7E CA         [24]  232         lcall   FW_PROG
      008441 E5 76            [12]  233         mov     a,MODE
      008443 25 5A            [12]  234         add     a,COLOR
      008445 25 7A            [12]  235         add     a,BRIGHT
      008447 25 77            [12]  236         add     a,SPEED
      008449 24 5A            [12]  237         add     a,#0x5a
      00844B FB               [12]  238         mov     r3,a
      00844C 7D 05            [12]  239         mov     r5,#5
      00844E 7F D0            [12]  240         mov     r7,#SECT
      008450 12 7E CA         [24]  241         lcall   FW_PROG
      008453                        242 done:
      008453 D0 E0            [24]  243         pop     acc
      008455 FF               [12]  244         mov     r7,a
      008456 D0 E0            [24]  245         pop     acc
      008458 FD               [12]  246         mov     r5,a
      008459 D0 E0            [24]  247         pop     acc
      00845B FB               [12]  248         mov     r3,a
      00845C D0 83            [24]  249         pop     dph
      00845E D0 82            [24]  250         pop     dpl
      008460 D0 D0            [24]  251         pop     psw
      008462 D0 E0            [24]  252         pop     acc
      008464 22               [24]  253         ret
